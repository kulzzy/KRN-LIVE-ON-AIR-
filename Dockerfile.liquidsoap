FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    liquidsoap \
    liquidsoap-plugin-icecast \
    ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY liquidsoap.liq /etc/liquidsoap/liquidsoap.liq

CMD ["liquidsoap", "/etc/liquidsoap/liquidsoap.liq"]
